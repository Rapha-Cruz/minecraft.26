<div class="card card-login">
  <h1>Alterar usuario</h1>
  <form action="/usuarios/alterar/<%= usuario.id_usuario %>" method="post" class="form-login">
    <label for="nome" class="label">Nome:</label>
    <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required class="input-form">
    <label for="usuario" class="label">Usuário:</label>
    <input type="text" id="usuario" name="usuario" value="<%= usuario.usuario %>" required class="input-form">
    <label for="senha" class="label">Senha:</label>
    <input type="password" id="senha" name="senha" class="input-form">  
    
    <button type="submit" class="botao-form botao-cadastrar">Salvar Alterações</button>
  </form>
  <br>
  <a href="/usuarios/listar" class="link-claro">Voltar para lista de usuarios</a>
</div> 
