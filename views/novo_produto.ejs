<div class="card-login">

    <h1 class="card-title">Cadastro de Produto</h1>

    <form action="/produtos/cadastro" method="post" class="form-login">

        <label for="nome" class="label">Nome do Produto:</label>
        <input type="text" id="nome" name="nome"
               class="input-form" required>

        <label for="estoque" class="label">Estoque:</label>
        <input type="number" step="0.01" id="estoque" name="estoque"
               class="input-form" required>

        <label for="estoque_minimo" class="label">Estoque Mínimo:</label>
        <input type="number" step="0.01" id="estoque_minimo"
               name="estoque_minimo" class="input-form" required>

        <label for="valor" class="label">Valor:</label>
        <input type="number" step="0.01" id="valor" name="valor"
               class="input-form" required>

        <label for="data_vencimento" class="label">Data de Vencimento:</label>
        <input type="date" id="data_vencimento"
               name="data_vencimento" class="input-form" lang="pt-BR">

        <label for="imagem" class="label">Imagem (URL):</label>
        <input type="text" id="imagem" name="imagem"
               class="input-form">

        <label for="categoria" class="label">Categoria:</label>
        <select id="categoria" name="id_categoria"
                class="input-form" required>

            <% categorias.forEach(categoria => { %>

                <option value="<%= categoria.id_categoria %>">
                    <%= categoria.nome %>
                </option>

            <% }) %>

        </select>

        <button type="submit" class="botao-form botao-cadastrar">
            Cadastrar
        </button>

        <a href="/produtos/listar" class="link-claro">
            Voltar
        </a>

    </form>

</div>