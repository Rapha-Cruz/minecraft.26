<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Armazém Minecraft</title>
  <link rel="icon" type="image/png" href="/img/favicon.png?v=2">
  <!-- Referência ao arquivo CSS externo para o estilo -->
   <!-- <link rel="stylesheet" href="/css/layout.css">
   <link rel="stylesheet" href="/css/layout_sand.css"> -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/img/favicon.ico?v=2">  
</head>
<body>
  <div class="container-principal">
    <header class="header-main">
      <div class="header-content">
        <nav class="nav-menu">
          <div class="nav-logo">
            <img src="/img/bauMinecraft.png" alt="Ícone de Armazém" class="rounded-lg">
            <span>Armazém de Itens</span>
          </div>

          

           <ul class="nav-links" id="menu"> <!--Responsividade adicionei id=menu -->
            <li><a href="/" class="nav-link">Home</a></li>   
			      <li><a href="/categorias/listar" class="nav-link">Categorias</a></li>
            <li><a href="/produtos/listar" class="nav-link">Produtos</a></li>
            <li><a href="/usuarios/listar" class="nav-link">Usuarios</a></li>
            <li><a href="/movimentacoes/listar" class="nav-link">Movimentações</a></li>
            <li><a href="/movimentacoes/listar_estoque" class="nav-link">Estoque</a></li>   
            <% if (usuarioLogado) { %>
              <li>
                <span class="sair">
                  Olá, <%= usuarioLogado.usuario %>!
                </span>
                </li>
                <li>
                <a href="/logout" class="nav-link ">Sair</a>
              </li>
            <% } else { %>
              <li><a href="/usuarios/login" class="nav-link">Login</a></li>
            <% } %>
          </ul>

          <!-- Responsividade -->
          <button class="botao-menu" onclick="alternarMenu()">
              &#9776;
          </button>
          <!-- Responsividade -->

        </nav>

        

      </div>
    </header>

    <main class="main-content">
      <%- body %>
    </main>	
    </div>

  <footer>
    &copy; 2026 SESI / SENAI
  </footer>

    <!-- Responsividade -->
    <script>
        function alternarMenu() {
            const menu = document.getElementById("menu");
            menu.classList.toggle("aberto");
        }
    </script>
    <!-- Responsividade -->

    </body>
</html>

